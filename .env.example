# Optional Docker Compose settings. The documented startup works without this file.
# If you copy this file to .env, keep PORT and ORIGIN in sync.
ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PORT=3000
# Inside Compose, MongoDB is reached by its service name, not localhost.
MONGODB_URI=mongodb://mongo:27017/doodleroom
# Admission ceiling, not a throughput claim; size deployments using docs/capacity.md.
MAX_ROOMS=200
# Keep metrics private when enabled in a production deployment.
ENABLE_METRICS=false
# For public HTTPS, set ORIGIN to the site's https:// URL and COOKIE_SECURE=true.
# For Node running directly on your computer, use the separate commands in
# docs/operations.md; their MongoDB URI is mongodb://127.0.0.1:27018/doodleroom_dev.
