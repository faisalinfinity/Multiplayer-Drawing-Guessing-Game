# Compose defaults work without an .env file. For HTTPS deployment:
ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PORT=3000
# Admission ceiling, not a throughput claim; size deployments using docs/capacity.md.
MAX_ROOMS=200
# Keep metrics private when enabled in a production deployment.
ENABLE_METRICS=false
# Direct local Node development:
MONGODB_URI=mongodb://127.0.0.1:27017/doodleroom
